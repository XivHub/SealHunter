<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Authors>Zhyra</Authors>
		<Company>ZhyraPlugins</Company>
		<Version>0.8.1</Version>
		<Description>Automates the Grand Company hunting log.</Description>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/edg-l/SealHunter</PackageProjectUrl>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
		<AssemblyName>SealHunter</AssemblyName>
		<RootNamespace>SealHunter</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.6" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\hunt_targets.json" />
		<EmbeddedResource Include="Combat\BossModPreset_Overworld.json" />
	</ItemGroup>

	<!-- Shared helpers (linked source from the sibling XivHubPluginKit repo). -->
	<ItemGroup>
		<Compile Include="..\..\XivHubPluginKit\DevTelemetry.cs" Link="Dev\DevTelemetry.cs" />
		<Compile Include="..\..\XivHubPluginKit\KitServices.cs" Link="Kit\KitServices.cs" />
		<Compile Include="..\..\XivHubPluginKit\PluginPresence.cs" Link="Kit\PluginPresence.cs" />
		<Compile Include="..\..\XivHubPluginKit\Game\LineOfSight.cs" Link="Kit\Game\LineOfSight.cs" />
		<Compile Include="..\..\XivHubPluginKit\Game\MountHelper.cs" Link="Kit\Game\MountHelper.cs" />
		<Compile Include="..\..\XivHubPluginKit\Game\SprintHelper.cs" Link="Kit\Game\SprintHelper.cs" />
		<Compile Include="..\..\XivHubPluginKit\Game\FlightHelper.cs" Link="Kit\Game\FlightHelper.cs" />
	</ItemGroup>

</Project>
