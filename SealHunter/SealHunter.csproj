<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Authors>Zhyra</Authors>
		<Company>ZhyraPlugins</Company>
		<Version>0.4.1</Version>
		<Description>Automates the Grand Company hunting log.</Description>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/edg-l/SealHunter</PackageProjectUrl>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
		<AssemblyName>SealHunter</AssemblyName>
		<RootNamespace>SealHunter</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.6" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\gc_hunt_targets.json" />
		<EmbeddedResource Include="Combat\BossModPreset_Overworld.json" />
	</ItemGroup>

	<!-- Shared dev-only helpers (linked source from the sibling ZhyraPluginKit repo). -->
	<ItemGroup>
		<Compile Include="..\..\ZhyraPluginKit\DevTelemetry.cs" Link="Dev\DevTelemetry.cs" />
	</ItemGroup>

</Project>
